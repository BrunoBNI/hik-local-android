<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/topbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <Spinner
            android:id="@+id/cameraSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playbackButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_playback"
            android:textColor="@color/text" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/text_dim"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="44dp"
            android:layout_height="62dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:alpha="0.7"
            android:background="#A6000000"
            android:contentDescription="@string/live_prev"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="44dp"
            android:layout_height="62dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:alpha="0.7"
            android:background="#A6000000"
            android:contentDescription="@string/live_next"
            android:src="@android:drawable/ic_media_next" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#A6000000"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/soundButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_lock_silent_mode" />

            <ImageButton
                android:id="@+id/snapshotButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageButton
                android:id="@+id/streamButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_menu_crop" />
        </LinearLayout>
    </FrameLayout>

    <GridLayout
        android:id="@+id/ptzPad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"
        android:columnCount="3"
        android:rowCount="3">

        <Space
            android:layout_width="58dp"
            android:layout_height="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzUp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▲"
            android:textColor="@color/text" />

        <Space
            android:layout_width="58dp"
            android:layout_height="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzLeft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="◀"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzZoomIn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzRight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▶"
            android:textColor="@color/text" />

        <Space
            android:layout_width="58dp"
            android:layout_height="48dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzDown"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="▼"
            android:textColor="@color/text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptzZoomOut"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="58dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="−"
            android:textColor="@color/text" />
    </GridLayout>
</LinearLayout>
