<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/topbar" />

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <Spinner
            android:id="@+id/cameraSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playbackButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_playback"
            android:textColor="@color/text" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/videoFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/text_dim"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/prevButton"
            android:layout_width="44dp"
            android:layout_height="62dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:alpha="0.7"
            android:background="#A6000000"
            android:contentDescription="@string/live_prev"
            android:src="@android:drawable/ic_media_previous" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="44dp"
            android:layout_height="62dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:alpha="0.7"
            android:background="#A6000000"
            android:contentDescription="@string/live_next"
            android:src="@android:drawable/ic_media_next" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="#A6000000"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/soundButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_lock_silent_mode" />

            <ImageButton
                android:id="@+id/snapshotButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_menu_camera" />

            <ImageButton
                android:id="@+id/streamButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_snapshot"
                android:src="@android:drawable/ic_menu_crop" />

            <ImageButton
                android:id="@+id/recordButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_record"
                android:src="@android:drawable/presence_video_online" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="#A6000000"
            android:orientation="horizontal"
            android:padding="2dp">

            <ImageButton
                android:id="@+id/zoomInButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_zoom_in"
                android:src="@android:drawable/ic_menu_zoom" />

            <ImageButton
                android:id="@+id/zoomOutButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_zoom_out"
                android:src="@android:drawable/ic_menu_zoom" />

            <ImageButton
                android:id="@+id/zoomResetButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_zoom_reset"
                android:src="@android:drawable/ic_menu_revert" />

            <ImageButton
                android:id="@+id/fullscreenButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/live_fullscreen"
                android:src="@android:drawable/ic_menu_view" />
        </LinearLayout>

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="#CCE2231A"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/live_recording"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
