<?xml version="1.0" encoding="utf-8"?>
<!--
  Vignette volontairement sobre : juste la petite fenêtre vidéo et son nom.
  Pas de badge flottant, pas de dégradé, pas d'icônes superposées — le clic
  sur l'image bascule directement vers la caméra en plein écran (Direct).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="3dp"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/tileFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black">

        <ImageView
            android:id="@+id/tileImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mosaic_preview_desc"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/tileLoading"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tileOff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/panel"
            android:gravity="center"
            android:text="⏻"
            android:textColor="@color/text_dim"
            android:textSize="20sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/tileToggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mosaic_toggle_desc"
            android:padding="4dp"
            android:src="@android:drawable/ic_lock_power_off" />
    </LinearLayout>
</LinearLayout>
