<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/black"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:id="@+id/tileFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <ImageView
            android:id="@+id/tileImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mosaic_preview_desc"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/tileLoading"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/tileOff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/panel"
            android:gravity="center"
            android:text="⏻"
            android:textColor="@color/text_dim"
            android:textSize="22sp"
            android:visibility="gone" />

        <!-- Dégradé + nom incrusté en bas, façon vignette de caméra classique. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_gravity="bottom"
            android:background="@drawable/mosaic_scrim" />

        <TextView
            android:id="@+id/tileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:ellipsize="end"
            android:maxLines="1"
            android:padding="8dp"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Badge d'action : coupe/réactive le flux, posé sur l'image comme
             un indicateur d'état plutôt qu'un bouton dans une rangée à part. -->
        <ImageButton
            android:id="@+id/tileToggle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/mosaic_badge_bg"
            android:contentDescription="@string/mosaic_toggle_desc"
            android:padding="5dp"
            android:src="@android:drawable/ic_lock_power_off" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
